_:
    @just --list

# Render machine configs locally without touching the cluster (writes ./output).
render:
    topf render

# Show what would change on each node; exits 2 if there is a diff.
diff:
    topf apply --dry-run

# Apply Talos machine config to running nodes.
apply:
    topf apply

# Bootstrap a fresh cluster: apply config, bootstrap etcd, fetch kubeconfig.
bootstrap:
    topf apply --auto-bootstrap
    topf kubeconfig

# topf writes it to stdout; TALOSCONFIG points at talos/talosconfig.
# Write a talosconfig for talosctl from the secrets bundle.
talosconfig:
    topf talosconfig > talosconfig

# tuppr normally drives this from the TalosUpgrade CR; out-of-band use only.
# Upgrade Talos OS on all nodes.
upgrade-talos:
    topf upgrade

# tuppr normally drives this from the KubernetesUpgrade CR; out-of-band use only.
# Upgrade Kubernetes on all nodes.
upgrade-k8s version:
    talosctl upgrade-k8s --to {{ version }}

# topf's own --full default is true, so this recipe pins it to preserve.
# Reset nodes and reboot; pass force=true to wipe the whole disk.
reset force="false":
    topf reset --full={{ if force == "false" { "false" } else { "true" } }} --graceful=false
